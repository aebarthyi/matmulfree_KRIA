# board.conf — deploy target for the BUILD-SERVER Makefile (`make deploy`).
# Copy to ./board.conf; the root Makefile -includes it (these defaults apply when absent).
# KEY=VAL only: make-includable and bash-sourceable, no spaces around '=', no $-expansion.
# Board-local device paths live in the bundle's board.conf (scripts/board.conf.example).

# user@host for `make deploy`.
BOARD=ubuntu@kria

# Remote dir that will CONTAIN transfer/ (the board works from $(BOARD_DEST)/transfer/).
BOARD_DEST=~
