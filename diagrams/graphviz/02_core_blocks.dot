// ============================================================================
// LEVEL 2 — Inside the FPGA: Core-level architecture in blocks.
//
// CoreTop is a thin Vivado-facing wrapper (clock/reset rename, N:1 s_axis join).
// Core holds the instruction handler, the top-level FSM, on-chip storage, the
// systolic array, and the drain/store datapath. Data plane = green, control
// plane = blue, storage = amber.
//
//   render:  dot -Tsvg 02_core_blocks.dot -o core_blocks.svg
// ============================================================================
digraph core_blocks {
    rankdir=LR;
    labelloc="t"; fontname="Helvetica-Bold"; fontsize=20;
    label="CoreTop / Core — Block Architecture (inside the FPGA)";
    node [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=9.5];
    compound=true; nodesep=0.4; ranksep=0.9;

    // ---- external AXI interfaces (from PS / DMA) ----
    io_saxi  [label="s_axi\nAXI4 slave (128-bit)\ninstruction MMIO", shape=cds, fillcolor="#d2e3fc", color="#1a73e8"];
    io_saxis [label="s_axis_0..3\n4 × 128-bit AXI4-Stream\nweights (COMPUTE) / act (LOAD)", shape=cds, fillcolor="#fde293", color="#e37400"];
    io_maxis [label="m_axis\nAXI4-Stream master\nresult beats (STORE)", shape=cds, fillcolor="#fde293", color="#e37400"];
    io_irq   [label="irq\nlevel-high on\ninstr complete", shape=cds, fillcolor="#d2e3fc", color="#1a73e8"];

    subgraph cluster_top {
        label="CoreTop (RawModule wrapper): aclk, aresetn→reset, s_axis N:1 join";
        fontname="Helvetica-Bold"; fontsize=12;
        style="rounded,filled"; fillcolor="#f8f9fa"; color="#80868b"; penwidth=1.6;

        join [label="s_axis join\n4×128b → 512b beat\n(all ports fire together)", fillcolor="#fef7e0", color="#e37400"];

        subgraph cluster_core {
            label="Core";
            fontname="Helvetica-Bold"; fontsize=13;
            style="rounded,filled"; fillcolor="#eef1f4"; color="#5f6368"; penwidth=1.8;

            // control plane
            handler [label="AxiInstructionHandler\n128-bit instr decode\nload/compute/store dispatch\nstatus + IRQ", fillcolor="#d2e3fc", color="#1a73e8", penwidth=1.6];
            fsm     [label="Top-level FSM\nsIdle · sLoad · sCompute · sStore\n(+ inner compute FSM)", fillcolor="#aecbfa", color="#1a73e8", penwidth=1.6];

            // storage
            actbram [label="actBram (BRAM)\ndepth maxN × (batch·aWidth)\nactivations, resident", fillcolor="#fde293", color="#e37400"];
            inq     [label="inQ  (Queue, 2-deep)\n(weight beat, activation) pairs", fillcolor="#fce8b2", color="#e37400"];
            arm     [label="armSlice\nReplicatedPipeSkid (max_fanout)\nactivation broadcast register", fillcolor="#fce8b2", color="#e37400"];

            // compute
            array   [label="SystolicArray\nyDim × xDim ternary-MAC PEs\n(see Level 3)", fillcolor="#a8dab5", color="#34a853", shape=box3d, penwidth=2];

            // drain / output
            tile    [label="tileAccums\ncaptured tile (batch-major)\nshift-down drain register", fillcolor="#ceead6", color="#34a853"];
            drain   [label="Drain engine\ntileAccums → outBram\n1 beat-wide row / cycle", fillcolor="#ceead6", color="#34a853"];
            outmem  [label="outBram / OutMemUltra\nURAM (ram_style=ultra)\ndepth batch·tiles·subBeats", fillcolor="#fde293", color="#e37400"];
            outq    [label="outQ (Queue, 2-deep)\ndecouples store → m_axis", fillcolor="#fce8b2", color="#e37400"];
        }
    }

    // ---- control wiring (blue) ----
    edge [color="#1a73e8", fontcolor="#1a73e8"];
    io_saxi -> handler [label="AXI4"];
    handler -> fsm     [label="load / compute / store\n(Decoupled cmds)"];
    fsm -> handler     [label="*Done", style=dashed];
    handler -> io_irq;
    fsm -> array   [label="nAcc rendezvous\n+ local reset", style=dashed];
    fsm -> drain   [label="capture / kick", style=dashed];

    // ---- data plane: LOAD path (amber) ----
    edge [color="#e37400", fontcolor="#e37400", penwidth=1.5];
    io_saxis -> join;
    join -> actbram [label="LOAD_ACT\nunpack → BRAM entry"];

    // ---- data plane: COMPUTE path (green/amber) ----
    join    -> inq  [label="COMPUTE_MM\nweight beat"];
    actbram -> inq  [label="activation row", color="#34a853"];
    inq  -> arm     [label="pairs (batched)"];
    arm  -> array   [label="weights + act\nper cycle", color="#34a853", penwidth=1.8];

    // ---- data plane: DRAIN + STORE path (green→amber) ----
    edge [color="#34a853", fontcolor="#34a853", penwidth=1.5];
    array -> tile   [label="capture accum tile\n(all yDim rows)"];
    tile  -> drain;
    drain -> outmem [label="write rows", color="#e37400"];
    edge [color="#e37400", fontcolor="#e37400"];
    outmem -> outq  [label="STORE_OUT\nread rows (pipelined)"];
    outq -> io_maxis;
}
