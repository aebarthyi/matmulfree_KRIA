// ============================================================================
// LEVEL 3a — Component zoom: CONTROL PLANE (word-level granularity).
//
//   • AxiInstructionHandler: the 128-bit instruction word field layout,
//     opcode decode, Decoupled command dispatch, and status/IRQ.
//   • Top-level FSM (sIdle/sLoad/sCompute/sStore) and the inner COMPUTE FSM
//     (cInit/cStream/cReset/cDone) that walks the column tiles.
//
//   render:  dot -Tsvg 03_core_control_internals.dot -o core_control_internals.svg
// ============================================================================
digraph core_control_internals {
    rankdir=TB;
    labelloc="t"; fontname="Helvetica-Bold"; fontsize=20;
    label="Core Internals — Control Plane (Instruction Handler + FSMs)";
    node [fontname="Helvetica", fontsize=11];
    edge [fontname="Helvetica", fontsize=9.5];
    compound=true; nodesep=0.4; ranksep=0.7;

    // ------------------------------------------------ 128-bit instruction word
    instr [shape=none, margin=0, label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
        <TR><TD COLSPAN="5" BGCOLOR="#1a73e8"><FONT COLOR="white"><B>128-bit instruction beat (written to s_axi RegMap.INSTR_WRITE, LSB-first)</B></FONT></TD></TR>
        <TR>
          <TD BGCOLOR="#d2e3fc"><B>flags</B><BR/>[127:112]<BR/>16b</TD>
          <TD BGCOLOR="#c9dcfb"><B>dim1</B><BR/>[111:80]<BR/>32b (cols M)</TD>
          <TD BGCOLOR="#d2e3fc"><B>dim0</B><BR/>[79:48]<BR/>32b (rows N / len)</TD>
          <TD BGCOLOR="#c9dcfb"><B>ptr</B><BR/>[47:8]<BR/>40b phys addr</TD>
          <TD BGCOLOR="#aecbfa"><B>opcode</B><BR/>[7:0]<BR/>8b</TD>
        </TR>
      </TABLE>>];

    opc [shape=none, margin=0, label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
        <TR><TD COLSPAN="2" BGCOLOR="#aecbfa"><B>opcode decode</B></TD></TR>
        <TR><TD>0x00</TD><TD>NOP</TD></TR>
        <TR><TD>0x01</TD><TD>LOAD_ACT</TD></TR>
        <TR><TD>0x02</TD><TD>COMPUTE_MM</TD></TR>
        <TR><TD>0x03</TD><TD>STORE_OUT</TD></TR>
      </TABLE>>];

    subgraph cluster_handler {
        label="AxiInstructionHandler";
        fontname="Helvetica-Bold"; fontsize=13;
        style="rounded,filled"; fillcolor="#eaf1fd"; color="#1a73e8"; penwidth=1.8;
        node [shape=box, style="rounded,filled", fillcolor="#d2e3fc", color="#1a73e8"];

        regmap  [label="AXI4 reg map\nINSTR_WRITE (push beat)\nSTATUS (read)"];
        pending [label="pendingInst : 128b\ninstReg : Instruction"];
        decode  [label="Instruction.decode\nopcode / ptr / dim0 / dim1 / flags"];
        disp    [label="dispatch (Decoupled):\nload {ptr,len}\ncompute {weightsPtr,rows,cols}\nstore {ptr,len}"];
        status  [label="StatusReg\nbusy · irqPending\nerrorCode · lastOpcode", fillcolor="#aecbfa"];
        errchk  [label="opcode valid?\nelse INVALID_OPCODE", fillcolor="#f6aea9", color="#c5221f"];

        regmap -> pending -> decode -> disp;
        decode -> errchk;
        errchk -> status; disp -> status;
    }

    // ------------------------------------------------------ top-level FSM
    subgraph cluster_fsm {
        label="Top-level FSM (state)";
        fontname="Helvetica-Bold"; fontsize=13;
        style="rounded,filled"; fillcolor="#e6f4ea"; color="#34a853"; penwidth=1.8;
        node [shape=circle, style="filled", fillcolor="#a8dab5", color="#34a853", fixedsize=true, width=1.05, fontsize=10];

        sIdle; sLoad; sCompute; sStore;
        sIdle -> sLoad    [label="LOAD_ACT.fire"];
        sIdle -> sCompute [label="COMPUTE_MM.fire"];
        sIdle -> sStore   [label="STORE_OUT.fire"];
        sLoad    -> sIdle [label="beats==len\n→ loadDone"];
        sCompute -> sIdle [label="all tiles drained\n→ computeDone"];
        sStore   -> sIdle [label="beats==total\n→ storeDone"];
    }

    // ------------------------------------------------ inner COMPUTE FSM
    subgraph cluster_cfsm {
        label="inner COMPUTE FSM (cState) — one pass per column tile";
        fontname="Helvetica-Bold"; fontsize=13;
        style="rounded,filled"; fillcolor="#fef7e0"; color="#e37400"; penwidth=1.8;
        node [shape=circle, style="filled", fillcolor="#fde293", color="#e37400", fixedsize=true, width=1.05, fontsize=10];

        cInit; cStream; cReset; cDone;
        cInit   -> cStream [label="prime actRdAddr=0"];
        cStream -> cStream [label="stream N beats\n(weights+act → array)", style=dashed];
        cStream -> cReset  [label="array.output.valid\n&& !drainBusy\n→ capture tile"];
        cReset  -> cStream [label="colTile+1 < numTiles\n(local array reset)"];
        cReset  -> cDone   [label="last tile"];
        cDone   -> cDone   [label="wait drainBusy=0\n&& drainFlush=0", style=dashed];
    }

    // ---- cross-cluster wiring ----
    edge [color="#5f6368", fontcolor="#5f6368", penwidth=1.4];
    instr -> regmap [lhead=cluster_handler, label="s_axi write"];
    opc -> decode  [style=dotted, constraint=false];
    disp -> sIdle  [lhead=cluster_fsm, label="load/compute/store\ncommands"];
    sCompute -> cInit [lhead=cluster_cfsm, label="drives inner FSM", style=dashed, color="#e37400", fontcolor="#e37400"];
    cDone -> status  [label="computeDone → IRQ", style=dotted, constraint=false, color="#1a73e8", fontcolor="#1a73e8"];

    { rank=same; instr; opc; }
}
