// ============================================================================
// LEVEL 3b — Component zoom: COMPUTE PLANE (word-level granularity).
//
//   • SystolicArray: yDim×xDim grid of PEs. Weights broadcast to every column
//     (no delay chain); one activation per row per cycle; nAcc is a one-shot
//     three-way rendezvous. All yDim rows exposed at the output boundary.
//   • PE datapath at word level: the 2-bit ternary weight decode (1→add,
//     3→sub, else hold), the per-lane accumReg, accumCounter, and 3-state FSM.
//
//   values shown for the 2.7B a16 B6 preset: aWidth=16 (nLanes=8), xDim=32,
//   yDim=batch=6, maxAcc=8192, accWidth = aWidth + headroom.
//
//   render:  dot -Tsvg 04_systolic_pe_internals.dot -o systolic_pe_internals.svg
// ============================================================================
digraph systolic_pe_internals {
    rankdir=LR;
    labelloc="t"; fontname="Helvetica-Bold"; fontsize=20;
    label="Core Internals — Compute Plane (SystolicArray + PE datapath)";
    node [fontname="Helvetica", fontsize=11];
    edge [fontname="Helvetica", fontsize=9.5];
    compound=true; nodesep=0.35; ranksep=0.9;

    // -------------------------------------------------- array-level inputs
    feed [shape=none, margin=0, label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5">
        <TR><TD COLSPAN="2" BGCOLOR="#34a853"><FONT COLOR="white"><B>array feed (per cycle, from armSlice)</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#ceead6"><B>weights_i</B></TD><TD>Vec(xDim·nLanes) of 2b<BR/>= 256 ternary weights (32·8)</TD></TR>
        <TR><TD BGCOLOR="#ceead6"><B>activation_i</B></TD><TD>Vec(yDim) of aWidth<BR/>= 6 × 16b (one per batch row)</TD></TR>
        <TR><TD BGCOLOR="#ceead6"><B>nAcc</B></TD><TD>log2(maxAcc)b one-shot<BR/>= accumulation count N</TD></TR>
      </TABLE>>];

    // -------------------------------------------------- SystolicArray cluster
    subgraph cluster_array {
        label="SystolicArray  (yDim rows × xDim cols)  —  weights broadcast, no delay chain";
        fontname="Helvetica-Bold"; fontsize=13;
        style="rounded,filled"; fillcolor="#e6f4ea"; color="#34a853"; penwidth=2;

        afsm [shape=box, style="rounded,filled", fillcolor="#ceead6", color="#34a853",
              label="array FSM (lockstep)\nidle → running → done\nstartable = weights.valid\n&& act.valid && nAcc.valid"];

        // representative PE grid (2 rows x 3 cols shown of yDim x xDim)
        node [shape=box, style="filled", fillcolor="#a8dab5", color="#34a853", fixedsize=true, width=1.0, height=0.55, fontsize=9];
        pe00 [label="PE(0,0)"]; pe01 [label="PE(0,1)"]; pe0x [label="… PE(0,xDim-1)", fixedsize=false];
        pe10 [label="PE(1,0)"]; pe11 [label="PE(1,1)"]; pe1x [label="… PE(1,·)", fixedsize=false];
        pey  [label="⋮ PE(yDim-1,·)", fixedsize=false, fillcolor="#ceead6"];

        { rank=same; pe00; pe01; pe0x; }
        { rank=same; pe10; pe11; pe1x; }

        // weight broadcast (same beat to every column, all rows)
        edge [color="#137333", style=bold, arrowsize=0.7];
        pe00 -> pe01 -> pe0x [label="weight beat\nbroadcast →", color="#137333"];
        pe10 -> pe11 -> pe1x [color="#137333"];
        // activation per row
        edge [color="#e37400", style=solid, arrowsize=0.7, constraint=false];
        pe00 -> pe10 [label="act[row]\n(per row)", dir=none];
    }

    // -------------------------------------------------- PE datapath zoom
    subgraph cluster_pe {
        label="PE datapath  (one processing element = nLanes independent ternary MACs)";
        fontname="Helvetica-Bold"; fontsize=13;
        style="rounded,filled"; fillcolor="#f1f8f4"; color="#137333"; penwidth=2;
        node [shape=box, style="rounded,filled"];

        pe_in [shape=none, margin=0, label=<
          <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
            <TR><TD COLSPAN="2" BGCOLOR="#137333"><FONT COLOR="white"><B>PE input bundle</B></FONT></TD></TR>
            <TR><TD BGCOLOR="#ceead6"><B>weights_i</B></TD><TD>Vec(nLanes) × 2b</TD></TR>
            <TR><TD BGCOLOR="#ceead6"><B>activation_i</B></TD><TD>aWidth (16b)</TD></TR>
            <TR><TD BGCOLOR="#ceead6"><B>nAcc</B></TD><TD>log2(maxAcc)b</TD></TR>
          </TABLE>>];

        decode2 [shape=none, margin=0, label=<
          <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
            <TR><TD COLSPAN="2" BGCOLOR="#137333"><FONT COLOR="white"><B>2-bit ternary decode (per lane)</B></FONT></TD></TR>
            <TR><TD>2'b01 (+1)</TD><TD>acc += act</TD></TR>
            <TR><TD>2'b11 (−1)</TD><TD>acc −= act</TD></TR>
            <TR><TD>else</TD><TD>hold (weight 0)</TD></TR>
          </TABLE>>];

        ext   [label="sign/zero extend\nact aWidth → accWidth\n(signedAct picks which)", fillcolor="#d7ede0", color="#137333"];
        addsub[label="± adder\n(no multiplier)", shape=box, fillcolor="#b7ddc6", color="#137333"];
        accreg[label="accumReg\nVec(nLanes) × accWidth\naccWidth = aWidth + headroom\n(=16+11=27 for this preset)", shape=box, fillcolor="#a8dab5", color="#137333", penwidth=1.6];
        cnt   [label="accumCounter\nCounter(maxAcc)\n+ nAccReg", fillcolor="#d7ede0", color="#137333"];
        pfsm  [label="PE FSM\nidle → running → done\nready = (state≠done)\nvalid = (state==done)\nself-clears on done→idle", shape=box, fillcolor="#ceead6", color="#137333"];

        pe_out [shape=none, margin=0, label=<
          <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
            <TR><TD BGCOLOR="#137333"><FONT COLOR="white"><B>PE output</B></FONT></TD></TR>
            <TR><TD BGCOLOR="#a8dab5">accum : Vec(nLanes) × accWidth</TD></TR>
          </TABLE>>];

        pe_in -> decode2 [label="weight lane"];
        pe_in -> ext     [label="activation"];
        decode2 -> addsub;
        ext -> addsub;
        accreg -> addsub [label="feedback", style=dashed, dir=back];
        addsub -> accreg [label="acc′"];
        cnt -> pfsm [label="count==nAcc-1\n→ done"];
        pfsm -> accreg [label="clear on done", style=dotted];
        accreg -> pe_out;
    }

    // ---- array → PE zoom link, and feed → array ----
    edge [color="#5f6368", fontcolor="#5f6368", penwidth=1.4];
    feed -> afsm [lhead=cluster_array, label="Decoupled\nrendezvous"];
    pe00 -> pe_in [lhead=cluster_pe, ltail=cluster_array, label="zoom into one PE", style=dashed, color="#137333", fontcolor="#137333"];

    // ---- array output boundary ----
    outb [shape=box, style="rounded,filled", fillcolor="#fde293", color="#e37400",
          label="output.accum\nVec(yDim) × Vec(xDim·nLanes) × accWidth\n(all rows exposed → tileAccums)"];
    pe_out -> outb [label="per (row,col,lane)", color="#e37400", fontcolor="#e37400"];
}
