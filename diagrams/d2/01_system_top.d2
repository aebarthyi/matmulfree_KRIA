# ============================================================================
# LEVEL 1 — System top: CPU (PS) + FPGA (PL) + MEMORY (DDR4), and where each
# part of a MMfreeLM decoder layer is computed.
#   render:  d2 --layout elk 01_system_top.d2 system_top.svg
# ============================================================================

title: "MMfreeLM on KRIA — System Architecture & LLM-Layer Compute Mapping" {
  near: top-center
  shape: text
  style: { font-size: 28; bold: true }
}

classes: {
  cpu:   { style: { fill: "#c9dcfb"; stroke: "#1a73e8"; border-radius: 10 } }
  mem:   { style: { fill: "#fde293"; stroke: "#e37400"; border-radius: 10 } }
  fpga:  { style: { fill: "#ceead6"; stroke: "#137333"; border-radius: 10 } }
  iface: { style: { fill: "#f1f3f4"; stroke: "#5f6368"; border-radius: 10 } }
}

cpu: ARM CPU — Zynq UltraScale+ PS (quad Cortex-A53) {
  style: { fill: "#e8f0fe"; stroke: "#4285f4"; stroke-width: 3; font-size: 18 }

  norm:  "RMSNorm (pre-mix)" { class: cpu }
  quant: "activation quantize\nfp → int8 / int16" { class: cpu }
  tok:   "MLGRU recurrence\nsigmoid · SiLU · elementwise\nsequential hidden-state scan" { class: cpu }
  glu:   "GLU activation\nSiLU(gate) ⊙ up  (elementwise)" { class: cpu }
  res:   "residual adds" { class: cpu }
  samp:  "final RMSNorm + sampling\nsoftmax / top-k / temperature" { class: cpu }
  drv:   "fpga_runner driver\nbuilds 128-bit instrs · DMA · IRQ" {
    style: { fill: "#aecbfa"; stroke: "#1a73e8" }
  }

  norm -> quant -> tok -> glu -> res -> samp: { style.stroke: "#9aa0a6" }
}

fpga: FPGA — Programmable Logic (CoreTop @ 250 MHz) {
  style: { fill: "#e6f4ea"; stroke: "#34a853"; stroke-width: 3; font-size: 18 }

  proj: BitLinear projections offloaded here {
    style: { fill: "#f1f8f4"; stroke: "#34a853"; stroke-dash: 4 }
    tokp:  "token-mix\nf · i · g · o_proj" { class: fpga }
    glup:  "channel-mix\ngate · up · down_proj" { class: fpga }
    headp: "lm_head\nhidden → vocab (32000)" { class: fpga }
  }
  core: "Ternary Matmul Core\nsystolic array of ternary-MAC PEs\nO[b][m] = Σ_n W[n][m] · A[b][n]" {
    shape: hexagon
    style: { fill: "#a8dab5"; stroke: "#137333"; stroke-width: 2 }
  }
}

mem: MEMORY — DDR4 (PS DRAM, u-dma-buf regions) {
  style: { fill: "#fef7e0"; stroke: "#f9ab00"; stroke-width: 3; font-size: 18 }
  wt:  "ternary weight blobs\npacked 2-bit, per-HP-port" { class: mem }
  act: "activation buffers\nudmabuf-act (int8/int16)" { class: mem }
  out: "output buffers\nudmabuf-out (int32 lanes)" { class: mem }
}

hpm: "M_AXI_HPM0\ninstruction MMIO (128-bit)" { class: iface }
dma: "AXI-DMA engines\n4 × MM2S (wt/act) + S2MM (out)" { class: iface }

# ---- logical layer sequence: which op offloads to which projection ----
cpu.quant -> fpga.proj.tokp: "② project" { style: { stroke: "#34a853"; stroke-dash: 3 } }
fpga.proj.tokp -> cpu.tok:   "③ recur"   { style: { stroke: "#34a853"; stroke-dash: 3 } }
cpu.tok -> fpga.proj.glup:   "④ project" { style: { stroke: "#34a853"; stroke-dash: 3 } }
fpga.proj.glup -> cpu.glu:   "⑤ SiLU⊙"   { style: { stroke: "#34a853"; stroke-dash: 3 } }
cpu.samp -> fpga.proj.headp: "⑧ lm_head" { style: { stroke: "#34a853"; stroke-dash: 3 } }

# ---- physical control + data plane ----
cpu.drv -> hpm: "push instruction" { style.stroke: "#1a73e8" }
hpm -> fpga.core: "LOAD_ACT / COMPUTE_MM / STORE_OUT" { style.stroke: "#1a73e8" }
fpga.core -> hpm: "IRQ / status" { style: { stroke: "#1a73e8"; stroke-dash: 4 } }

cpu.quant -> mem.act: "quantized act → DDR" { style.stroke: "#e37400" }
mem.act -> dma: "LOAD_ACT" { style.stroke: "#e37400" }
mem.wt -> dma: "COMPUTE_MM\nweights stream every cycle" { style.stroke: "#e37400" }
dma -> fpga.core: "4 × 128-bit HP = 512-bit beat" { style.stroke: "#e37400" }
fpga.core -> dma: "STORE_OUT result beats" { style.stroke: "#e37400" }
dma -> mem.out: "results → DDR" { style.stroke: "#e37400" }
mem.out -> cpu.res: "read back" { style.stroke: "#e37400" }
