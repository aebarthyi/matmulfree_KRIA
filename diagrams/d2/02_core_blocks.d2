# ============================================================================
# LEVEL 2 — Inside the FPGA: Core-level architecture in blocks.
#   render:  d2 --layout elk 02_core_blocks.d2 core_blocks.svg
# ============================================================================

title: "CoreTop / Core — Block Architecture (inside the FPGA)" {
  near: top-center
  shape: text
  style: { font-size: 28; bold: true }
}

classes: {
  ctrl:  { style: { fill: "#d2e3fc"; stroke: "#1a73e8"; border-radius: 8 } }
  store: { style: { fill: "#fde293"; stroke: "#e37400"; border-radius: 8 } }
  comp:  { style: { fill: "#a8dab5"; stroke: "#137333"; border-radius: 8 } }
  queue: { style: { fill: "#fce8b2"; stroke: "#e37400"; border-radius: 8 } }
}

# ---- external AXI interfaces ----
io_saxi:  "s_axi\nAXI4 slave (128-bit)\ninstruction MMIO" { shape: cloud; style.fill: "#d2e3fc" }
io_saxis: "s_axis_0..3\n4 × 128-bit AXI4-Stream\nweights / activations" { shape: cloud; style.fill: "#fde293" }
io_maxis: "m_axis\nAXI4-Stream master\nresult beats" { shape: cloud; style.fill: "#fde293" }
io_irq:   "irq\nlevel-high on complete" { shape: cloud; style.fill: "#d2e3fc" }

coretop: "CoreTop (RawModule): aclk, aresetn→reset, s_axis 4:1 join" {
  style: { fill: "#f8f9fa"; stroke: "#80868b"; font-size: 16 }

  join: "s_axis join\n4×128b → 512b beat" { class: store }

  core: Core {
    style: { fill: "#eef1f4"; stroke: "#5f6368"; font-size: 17 }

    handler: "AxiInstructionHandler\n128-bit decode · dispatch\nstatus + IRQ" { class: ctrl }
    fsm:     "Top-level FSM\nsIdle · sLoad · sCompute · sStore\n(+ inner compute FSM)" {
      style: { fill: "#aecbfa"; stroke: "#1a73e8"; border-radius: 8 }
    }

    actbram: "actBram (BRAM)\ndepth maxN × batch·aWidth\nactivations, resident" { class: store }
    inq:     "inQ (Queue, 2-deep)\n(weight beat, activation) pairs" { class: queue }
    arm:     "armSlice\nReplicatedPipeSkid (max_fanout)\nactivation broadcast reg" { class: queue }

    array:   "SystolicArray\nyDim × xDim ternary-MAC PEs\n(see Level 3)" {
      shape: hexagon
      class: comp
    }

    tile:    "tileAccums\ncaptured tile, batch-major\nshift-down drain register" { class: comp }
    drain:   "Drain engine\ntileAccums → outBram\n1 beat-wide row / cycle" { class: comp }
    outmem:  "outBram / OutMemUltra\nURAM (ram_style=ultra)\ndepth batch·tiles·subBeats" { class: store }
    outq:    "outQ (Queue, 2-deep)\ndecouples store → m_axis" { class: queue }
  }
}

# ---- control plane (blue) ----
io_saxi -> coretop.core.handler: "AXI4" { style.stroke: "#1a73e8" }
coretop.core.handler -> coretop.core.fsm: "load/compute/store cmds" { style.stroke: "#1a73e8" }
coretop.core.fsm -> coretop.core.handler: "*Done" { style: { stroke: "#1a73e8"; stroke-dash: 4 } }
coretop.core.handler -> io_irq: "" { style.stroke: "#1a73e8" }
coretop.core.fsm -> coretop.core.array: "nAcc + local reset" { style: { stroke: "#1a73e8"; stroke-dash: 4 } }
coretop.core.fsm -> coretop.core.drain: "capture / kick" { style: { stroke: "#1a73e8"; stroke-dash: 4 } }

# ---- LOAD path ----
io_saxis -> coretop.join: "" { style.stroke: "#e37400" }
coretop.join -> coretop.core.actbram: "LOAD_ACT unpack → BRAM" { style.stroke: "#e37400" }

# ---- COMPUTE path ----
coretop.join -> coretop.core.inq: "COMPUTE_MM weight beat" { style.stroke: "#e37400" }
coretop.core.actbram -> coretop.core.inq: "activation row" { style.stroke: "#137333" }
coretop.core.inq -> coretop.core.arm: "pairs (batched)" { style.stroke: "#e37400" }
coretop.core.arm -> coretop.core.array: "weights + act / cycle" { style.stroke: "#137333" }

# ---- DRAIN + STORE path ----
coretop.core.array -> coretop.core.tile: "capture accum tile (all rows)" { style.stroke: "#137333" }
coretop.core.tile -> coretop.core.drain: "" { style.stroke: "#137333" }
coretop.core.drain -> coretop.core.outmem: "write rows" { style.stroke: "#e37400" }
coretop.core.outmem -> coretop.core.outq: "STORE_OUT read (pipelined)" { style.stroke: "#e37400" }
coretop.core.outq -> io_maxis: "" { style.stroke: "#e37400" }
